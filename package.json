{
  "name": "dsh-font-subset",
  "version": "1.0.0",
  "description": "Cut a font down to the characters actually used and report characters the font lacks. Turns a 9 MB Chinese font into a few KB for the page that needs it.",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "subset-font": "^2.9.0"
  },
  "peerDependencies": { "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7" },
  "peerDependenciesMeta": { "@deepseek-ai/dsh-tools": { "optional": true } },
  "keywords": ["dsh-plugin", "font", "subset", "woff2", "webfont", "cjk"],
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "git+https://github.com/Lee2277-t/dsh-font-subset.git" }
}